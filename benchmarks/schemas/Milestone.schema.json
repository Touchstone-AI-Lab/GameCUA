{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "predicate": {
      "minLength": 1,
      "title": "Predicate",
      "type": "string"
    },
    "points": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Points",
      "type": "integer"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "duplicate_credit": {
      "const": "once_per_trial",
      "default": "once_per_trial",
      "title": "Duplicate Credit",
      "type": "string"
    },
    "scope": {
      "const": "episode",
      "default": "episode",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "id",
    "description",
    "predicate",
    "points"
  ],
  "title": "Milestone",
  "type": "object"
}
